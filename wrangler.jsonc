{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postplan",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "postplan",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DRAFTS",
      "bucket_name": "postplan-drafts"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
