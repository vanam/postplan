{
  "name": "postplan",
  "version": "0.0.5",
  "description": "Static HTML draft publishing for agents.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/",
    "skills/",
    "README.md"
  ],
  "bin": {
    "postplan": "./dist/postplan.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "esbuild bin/postplan.js --bundle --platform=node --format=esm --external:commander --external:parse5 --outfile=dist/postplan.js",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@postplan/html-policy": "workspace:*",
    "esbuild": "^0.28.1"
  }
}
