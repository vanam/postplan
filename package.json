{
  "name": "postplan",
  "version": "0.0.4",
  "description": "A Cloudflare Worker for publishing static HTML drafts.",
  "type": "module",
  "license": "MIT",
  "files": [
    ".dev.vars.example",
    "migrations/",
    "src/",
    "README.md",
    "wrangler.jsonc"
  ],
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "test": "vitest run",
    "check:bundle": "wrangler deploy --dry-run --outdir /tmp/postplan-worker-build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "jose": "^6.2.3",
    "nanoid": "^5.1.5",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "jsonc-parser": "^3.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
