{
  "name": "postplan-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "start": "pnpm --filter @postplan/server start",
    "dev": "pnpm --filter @postplan/server dev",
    "cli": "node packages/cli/bin/postplan.js",
    "config:generate": "pnpm --filter @postplan/server config:generate",
    "deploy": "pnpm --filter @postplan/server run deploy",
    "db:migrate": "pnpm --filter @postplan/server db:migrate",
    "db:migrate:remote": "pnpm --filter @postplan/server db:migrate:remote",
    "test": "pnpm -r test",
    "test:integration": "node scripts/verify-local.js",
    "test:e2e": "node --env-file-if-exists=.env --test scripts/e2e.js",
    "pack:cli": "pnpm --filter ./packages/cli build && pnpm --filter ./packages/cli pack --out postplan-cli.tgz",
    "check:bundle": "pnpm --filter @postplan/server check:bundle"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
